# Copy this file to ".env" for LOCAL testing only. Never commit the real .env file.
# On Render, do NOT use this file. Set ANTHROPIC_API_KEY in the dashboard's
# Environment tab instead. See README.md for the full walkthrough.

ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional. Render sets this automatically. Only needed for local runs on a
# different port.
PORT=3000
